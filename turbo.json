{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "dist/**"],
            "env": ["POSTGRES_URL", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET"]
        },
        "lint": {
            "dependsOn": ["^lint"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": []
        }
    }
}
